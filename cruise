#!/usr/bin/env bash

UNAMEOUT="$(uname -s)"

# Verify operating system is supported...
case "${UNAMEOUT}" in
    Linux*)             MACHINE=linux;;
    Darwin*)            MACHINE=mac;;
    *)                  MACHINE="UNKNOWN"
esac

if [ "$MACHINE" == "UNKNOWN" ]; then
    echo "Unsupported operating system [$(uname -s)]. Cruise supports macOS, Linux, and Windows (WSL2)." >&2

    exit 1
fi

CRUISE_DIRECTORY="$HOME/.cruise"

# Source the ".config" file for environment variables...
if [ -f "$CRUISE_DIRECTORY/.config" ]; then
    source "$CRUISE_DIRECTORY/.config"
fi

# Define global parameters...
IMAGE_VERSION=$DEFAULT_IMAGE_VERSION
CONTAINER_NAME=$CONTAINER_NAME_PATTERN
SHELL_USER=$DEFAULT_SHELL_USER
SERVER="nginx"
EXPOSE_PORTS=()

# Determine if stdout is a terminal...
if test -t 1; then
    # Determine if colors are supported...
    ncolors=$(tput colors)

    if test -n "$ncolors" && test "$ncolors" -ge 8; then
        BOLD="$(tput bold)"
        RED="$(tput setaf 1)"
        GREEN="$(tput setaf 2)"
        YELLOW="$(tput setaf 3)"
        CYAN="$(tput setaf 6)"
        NC="$(tput sgr0)"
    fi
fi

# Function that prints the available commands...
function display_help {
    echo "Cruise"
    echo
    echo "${YELLOW}Usage:${NC}" >&2
    echo "  cruise [command] [options] [arguments]"
    echo
    echo "${YELLOW}Commands:${NC}"
    echo "  ${GREEN}environments${NC}        Show available environments to build"
    echo "  ${GREEN}build${NC}               Build the cruise image"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "    ${BOLD}-f${NC}                 Rebuild from scratch"
    echo "  ${GREEN}start${NC}               Start the application"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "    ${BOLD}-n <network>${NC}       Specify a docker network (Default: ${DEFAULT_NETWORK})"
    echo "    ${BOLD}-i <ip>${NC}            Specify a static ip for container (Default: Auto assigned)"
    echo "    ${BOLD}-p <port>${NC}          Specify a port to listen (Default: ${DEFAULT_PORT})"
    echo "    ${BOLD}-e <port:port>${NC}     Specify local port to container port (i.e. 3000:3000)"
    echo "    ${BOLD}-s <server>${NC}        Specify a server (i.e. nginx|octane)"
    echo "    ${BOLD}-c <command>${NC}       Specify a command for startup (Overrides -s option)"
    echo "    ${BOLD}-l <key=value>${NC}     Specify label key value for container (i.e. key=value)"
    echo "    ${BOLD}-b${NC}                 Run in the background"
    echo "  ${GREEN}stop${NC}                Stop the application"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "    ${BOLD}-f${NC}                 Stop the application and remove the container"
    echo "  ${GREEN}restart${NC}             Restart the application"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "  ${GREEN}status${NC}              Show cruise status"
    echo "  ${GREEN}containers${NC}          Show running cruise containers"
    echo "    ${BOLD}-a${NC}                 Show all cruise containers"
    echo "  ${GREEN}check${NC}               Check project image and container status"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "  ${GREEN}shell${NC}               Start a shell in the folder"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "    ${BOLD}-n <network>${NC}       Specify a docker network (Default: ${DEFAULT_NETWORK})"
    echo "    ${BOLD}-e <port:port>${NC}     Specify local port to container port (i.e. 3000:3000)"
    echo "    ${BOLD}-u <user>${NC}          Specify a user to run the shell as (Default: ${SHELL_USER})"
    echo "    ${BOLD}-b${NC}                 Run in the background"
    echo "  ${GREEN}root-shell${NC}          Start a root shell in the folder"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "    ${BOLD}-n <network>${NC}       Specify a docker network (Default: ${DEFAULT_NETWORK})"
    echo "    ${BOLD}-e <port:port>${NC}     Specify local port to container port (i.e. 3000:3000)"
    echo "    ${BOLD}-b${NC}                 Run in the background"
    echo "  ${GREEN}run${NC}                 Run an executable from inside of the container"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "  ${GREEN}export${NC}              Backup a cruise image as .tar"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "  ${GREEN}import${NC}              Import a cruise image from provided path"
    echo "  ${GREEN}remove${NC}              Remove a built cruise image"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "    ${BOLD}-a${NC}                 Remove all dependent images"
    echo "    ${BOLD}-f${NC}                 Force remove the image"
    echo "  ${GREEN}create${NC}              Create a Laravel project in the folder"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "  ${GREEN}traefik${NC}             Start the application in Traefik proxy"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo "    ${BOLD}-n <network>${NC}       Specify a docker network (Default: ${DEFAULT_NETWORK})"
    echo "    ${BOLD}-i <ip>${NC}            Specify a static ip for container (Default: Auto assigned)"
    echo "    ${BOLD}-p <port>${NC}          Specify a port to listen (Default: ${DEFAULT_PORT})"
    echo "    ${BOLD}-e <port:port>${NC}     Specify local port to container port (i.e. 3000:3000)"
    echo "    ${BOLD}-s <server>${NC}        Specify a server (i.e. nginx|octane)"
    echo "    ${BOLD}-c <command>${NC}       Specify a command for startup (Overrides -s option)"
    echo "    ${BOLD}-l <key=value>${NC}     Specify label key value for container (i.e. key=value)"
    echo "    ${BOLD}-b${NC}                 Run in the background"
    echo "  ${GREEN}code${NC}                Open project in vscode inside the container"
    echo "    ${BOLD}-v <version>${NC}       Specify a version (Default: ${DEFAULT_IMAGE_VERSION})"
    echo
    echo "  ${GREEN}install${NC}             Install cruise binary"
    echo "  ${GREEN}uninstall${NC}           Uninstall cruise binary"
    echo "    ${BOLD}-f${NC}                 Stop cruise, remove the container and uninstall binary"

    exit "${1:-1}"
}

# Proxy the "help" command...
if [ $# -gt 0 ]; then
    if [ "$1" == "help" ] || [ "$1" == "-h" ] || [ "$1" == "-help" ] || [ "$1" == "--help" ]; then
        display_help 0
    fi
else
    display_help 1
fi

# Function that outputs Cruise is not running...
function cruise_is_not_running {
    echo "${YELLOW}Cruise is not running for this location or project.${NC}" >&2
    echo "${YELLOW}You may run Cruise using:${NC} ${GREEN}cruise start${NC} or ${GREEN}cruise traefik${NC}" >&2

    exit 1
}

# Function that outputs Invalid arguments provided...
function invalid_arguments_provided {
    echo "${BOLD}Invalid arguments provided.${NC}" >&2

    exit 1
}

function check_if_docker_running {
    # Ensure that Docker is running...
    if ! docker info > /dev/null 2>&1; then
        echo "${BOLD}Docker is not running.${NC}" >&2

        exit 1
    fi
}

function check_if_network_exists {
    # Check if the network exist for the containers...
    if [ ! "$(docker network ls | grep $DEFAULT_NETWORK)" ]; then
        echo "${BOLD}Application network doesn't exist.${NC}" >&2
        echo "${BOLD}Creating network $DEFAULT_NETWORK...${NC}" >&2

        docker network create $DEFAULT_NETWORK

        echo "${GREEN}Created network $DEFAULT_NETWORK.${NC}" >&1
    fi
}

function check_if_config_file_exists {
    # Check if .cruise config file missing and -b option is provided in command...
    if [[ ! -f ".cruise" && -n "$background" ]]; then
        cat <<EOL > ".cruise"
IMAGE_VERSION=$IMAGE_VERSION
EOL
        source ".cruise"
    fi

    # Check if -v option is provided in command...
    if [ -n "$NEW_IMAGE_VERSION" ]; then
        sed -i.bak "s|^IMAGE_VERSION=.*|IMAGE_VERSION=$NEW_IMAGE_VERSION|" ".cruise" && rm -f ".cruise.bak"

        echo "${GREEN}Updating .cruise config file...${NC}" >&1

        source ".cruise"
    fi

    # Check if .cruise config file exists in the project directory...
    if [[ -f ".cruise" && -s ".cruise" ]]; then
        echo "${GREEN}Loading environment from .cruise config file...${NC}" >&1

        source ".cruise"
    fi
}

function configure_vscode_attach_config {
    local CONFIG_VERSION="$1"

    if [ -z "$CONFIG_VERSION" ]; then
        echo "${YELLOW}No image version found, vscode attach config skipped...${NC}" >&2

        return 1
    fi

    local EDITOR_DIRS
    local APP_DIR WSL_USER_DIR USER_DIR CONFIG_FILE CONFIG_WORKSPACE

    if [ "$MACHINE" == "mac" ]; then
        EDITOR_DIRS=("$HOME/Library/Application Support/Code - Insiders" "$HOME/Library/Application Support/Code" "$HOME/Library/Application Support/VSCodium")
    else
        EDITOR_DIRS=("$HOME/.config/Code - Insiders" "$HOME/.config/Code" "$HOME/.config/VSCodium")

        # WSL2: vscode runs on the windows host side...
        if grep -qi microsoft /proc/version 2> /dev/null; then
            for WSL_USER_DIR in /mnt/c/Users/*; do
                test -d "$WSL_USER_DIR" || continue

                EDITOR_DIRS+=("$WSL_USER_DIR/AppData/Roaming/Code - Insiders" "$WSL_USER_DIR/AppData/Roaming/Code" "$WSL_USER_DIR/AppData/Roaming/VSCodium")
            done
        fi
    fi

    # Prefer editors where the dev containers extension is already in use...
    USER_DIR=""
    for APP_DIR in "${EDITOR_DIRS[@]}"; do
        if [ -d "$APP_DIR/User/globalStorage/ms-vscode-remote.remote-containers" ]; then
            USER_DIR="$APP_DIR/User"
            break
        fi
    done

    # Fallback to the first existing editor config directory...
    if [ -z "$USER_DIR" ]; then
        for APP_DIR in "${EDITOR_DIRS[@]}"; do
            if [ -d "$APP_DIR/User" ]; then
                USER_DIR="$APP_DIR/User"
                break
            fi
        done
    fi

    if [ -z "$USER_DIR" ]; then
        echo "${YELLOW}Vscode config directory not found, attach config skipped...${NC}" >&2

        return 1
    fi

    # Attached containers are configured per image, not by any project devcontainer.json...
    CONFIG_FILE="$USER_DIR/globalStorage/ms-vscode-remote.remote-containers/imageConfigs/cruise-$CONFIG_VERSION%3alatest.json"
    CONFIG_WORKSPACE=${WORKING_DIRECTORY:-/var/www/html}

    if [ ! -f "$CONFIG_FILE" ]; then
        mkdir -p "$USER_DIR/globalStorage/ms-vscode-remote.remote-containers/imageConfigs"

        if printf '{\n\t"workspaceFolder": "%s",\n\t"remoteUser": "cruise"\n}\n' "$CONFIG_WORKSPACE" > "$CONFIG_FILE"; then
            echo "${GREEN}Vscode attach config created for cruise user ($CONFIG_FILE)...${NC}" >&1
        else
            echo "${YELLOW}Failed to create vscode attach config ($CONFIG_FILE)...${NC}" >&2

            return 1
        fi
    elif ! grep -q '"remoteUser"' "$CONFIG_FILE"; then
        # Inject remote user without clobbering any manual configuration...
        if awk '/^[ \t]*\{[ \t]*$/ && !inserted { print; printf "\t\"remoteUser\": \"cruise\",\n"; inserted = 1; next } { print }' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv -f "$CONFIG_FILE.tmp" "$CONFIG_FILE" && grep -q '"remoteUser"' "$CONFIG_FILE"; then
            echo "${GREEN}Vscode attach config updated for cruise user ($CONFIG_FILE)...${NC}" >&1
        else
            rm -f "$CONFIG_FILE.tmp"

            echo "${YELLOW}Vscode attach config ($CONFIG_FILE) needs \"remoteUser\": \"cruise\" manually...${NC}" >&2
        fi
    fi

    return 0
}

ARGS=()

# Install cruise binary...
if [ "$1" == "install" ]; then
    shift 1

    # Check if cruise binary is not installed...
    if ! type cruise > /dev/null 2>&1; then
        echo "${BOLD}Installing cruise binary...${NC}" >&2

        check_if_docker_running
        check_if_network_exists

        sudo mkdir -p /usr/local/bin
        sudo ln -sf "$CRUISE_DIRECTORY/cruise" /usr/local/bin/cruise
        INSTALL_STATUS=$?

        # Bash completions: Homebrew prefix on macOS, /etc on Linux...
        if [ -d /opt/homebrew/etc/bash_completion.d ]; then
            sudo ln -sf "$CRUISE_DIRECTORY/completions/cruise-completion" /opt/homebrew/etc/bash_completion.d/cruise-completion
        elif [ -d /usr/local/etc/bash_completion.d ]; then
            sudo ln -sf "$CRUISE_DIRECTORY/completions/cruise-completion" /usr/local/etc/bash_completion.d/cruise-completion
        elif [ "$MACHINE" == "mac" ]; then
            echo "${YELLOW}Bash completions skipped. Run 'brew install bash-completion' and reinstall, or add 'source $CRUISE_DIRECTORY/completions/cruise-completion' to your ~/.bash_profile.${NC}" >&2
        else
            sudo mkdir -p /etc/bash_completion.d
            sudo ln -sf "$CRUISE_DIRECTORY/completions/cruise-completion" /etc/bash_completion.d/cruise-completion

            if [ $? -ne 0 ]; then
                INSTALL_STATUS=1
            fi
        fi

        if [ -d "$HOME/.oh-my-zsh/custom" ]; then
            sudo ln -sf "$CRUISE_DIRECTORY/completions/cruise-completion" "$HOME/.oh-my-zsh/custom/cruise-completion.zsh"
        fi

        if [ "$INSTALL_STATUS" == 0 ]; then
            echo "${GREEN}Installation successful!${NC}" >&1
        else
            echo "${RED}Installation failed!${NC}" >&2
        fi
    else
        echo "${BOLD}Cruise binary is already installed.${NC}" >&2
    fi

    exit 0

# Uninstall the application image and cruise binary...
elif [ "$1" == "uninstall" ]; then
    shift 1

    while getopts f OPTION; do
        case $OPTION in
            f) full="yes";;
            *) invalid_arguments_provided;;
        esac
    done

    echo "${YELLOW}Uninstall cruise binary from your system (y/n)?${NC}"
    read -r confirm

    if [ "$confirm" == "y" ]; then
        # Check if full uninstall...
        if [ "$full" == "yes" ]; then
            CRUISE_CONTAINERS=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -E '[^-]+-cruise-[^-]+')

            # Check if any cruise containers running...
            if [[ -n "$CRUISE_CONTAINERS" ]]; then
                echo "${BOLD}Found running cruise containers. Stopping and removing...${NC}" >&1

                docker rm -f $CRUISE_CONTAINERS
            else
                echo "${BOLD}No running cruise containers found.${NC}" >&1
            fi
        fi

        # Check if cruise binary is already installed...
        if type cruise > /dev/null 2>&1; then
            echo "${BOLD}Cruise binary is found.${NC}" >&1
            echo "${BOLD}Uninstalling cruise binary...${NC}" >&1

            sudo rm -f /usr/local/bin/cruise
            UNINSTALL_STATUS=$?

            sudo rm -f /etc/bash_completion.d/cruise-completion /opt/homebrew/etc/bash_completion.d/cruise-completion /usr/local/etc/bash_completion.d/cruise-completion

            if [ $? -ne 0 ]; then
                UNINSTALL_STATUS=1
            fi

            if [ -f "$HOME/.oh-my-zsh/custom/cruise-completion.zsh" ]; then
                sudo rm -f "$HOME/.oh-my-zsh/custom/cruise-completion.zsh"
            fi

            if [ "$UNINSTALL_STATUS" == 0 ]; then
                echo "${GREEN}Uninstall successful!${NC}" >&1
            else
                echo "${RED}Cannot uninstall binary. Manually remove the binary from '/usr/local/bin/cruise'${NC}" >&2
            fi
        else
            echo "${BOLD}Cruise binary is not installed.${NC}" >&2
        fi
    else
        echo "${GREEN}Uninstall cancelled!${NC}" >&1
    fi

    exit 0

# Build the application image...
elif [ "$1" == "build" ]; then
    shift 1

    while getopts v:f OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            f) fresh_install="--no-cache";; # Append --no-cache if provided
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        IMAGE_VERSION=$NEW_IMAGE_VERSION
    fi

    echo "${GREEN}Building image with following parameters...${NC}" >&1
    echo "${BOLD}v) $IMAGE_VERSION${NC}" >&1
    echo "${BOLD}f) $fresh_install${NC}" >&1
    echo "${GREEN}Base image name will be${NC} cruise-$IMAGE_VERSION:latest" >&1
    echo "" >&1

    ARGS+=(docker build --build-arg WWWGROUP=$(id -g) --build-arg WWWUSER=$(id -u) --build-arg PHP_VERSION=$IMAGE_VERSION -f $CRUISE_DIRECTORY/environments/$IMAGE_VERSION/Dockerfile -t cruise-$IMAGE_VERSION:latest $CRUISE_DIRECTORY/environments $fresh_install)

# Show available image versions...
elif [ "$1" == "environments" ]; then
    shift 1

    echo "${GREEN}Available environments to use...${NC}" >&1
    ls ~/.cruise/environments
    echo "" >&1

    exit 0

# Backup the application image for using offline...
elif [ "$1" == "export" ]; then
    shift 1

    while getopts v: OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        IMAGE_VERSION=$NEW_IMAGE_VERSION
    fi

    echo "${GREEN}Exporting image with following parameters...${NC}" >&1
    echo "${BOLD}v) $IMAGE_VERSION${NC}" >&1
    echo "${GREEN}Creating backup in $CRUISE_DIRECTORY/backup/cruise-$IMAGE_VERSION.tar${NC}" >&1
    echo "${GREEN}Please wait..." >&1
    echo "" >&1

    mkdir -p "$CRUISE_DIRECTORY/backup"
    ARGS+=(docker image save -o "$CRUISE_DIRECTORY/backup/cruise-$IMAGE_VERSION.tar" "cruise-$IMAGE_VERSION:latest")

# Import backed up application image...
elif [ "$1" == "import" ]; then
    shift 1

    # Check if argument provided
    if [ -z "$1" ]; then
        echo "${RED}Backup path not provided${NC}" >&2

        exit 1
    fi

    # Check if file exists in the provided path
    if [ ! -f "$1" ]; then
        echo "${RED}Backup not found at $1${NC}" >&2

        exit 1
    fi

    check_if_docker_running
    check_if_network_exists

    echo "${GREEN}Importing image from $1${NC}" >&1
    echo "${GREEN}Please wait..." >&1
    echo "" >&1

    ARGS+=(docker image load -i "$1")

# Remove the application build image...
elif [ "$1" == "remove" ]; then
    shift 1

    while getopts av:f OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            a) all="yes";;
            f) force="-f";;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        IMAGE_VERSION=$NEW_IMAGE_VERSION
    # Check if .cruise config file exists in the project directory...
    elif [[ -f ".cruise" && -s ".cruise" ]]; then
        echo "${GREEN}Loading environment from .cruise config file...${NC}" >&1

        source ".cruise"
    fi

    # Check if the user wants to remove all dependent images
    if [ "$all" == "yes" ]; then
        # Find all the containers using the image
        DEPENDENT_CONTAINERS=$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E "[^-]+-cruise-${IMAGE_VERSION}([^-]+)?")

        if [ -n "$DEPENDENT_CONTAINERS" ]; then
            echo "${GREEN}Dependent containers found for image:${NC} cruise-$IMAGE_VERSION:latest" >&1
            echo "${GREEN}Stopping and removing dependent containers...${NC}" >&1

            docker rm -f $DEPENDENT_CONTAINERS
        fi
    fi

    ARGS+=(docker rmi $force cruise-$IMAGE_VERSION:latest)

# Start the application container...
elif [ "$1" == "start" ]; then
    shift 1

    while getopts v:n:i:p:e:s:c:l:b OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            n) DEFAULT_NETWORK=${OPTARG};;
            i) DEFAULT_IP=${OPTARG};;
            p) DEFAULT_PORT=${OPTARG};;
            e) EXPOSE_PORTS+=(${OPTARG});;
            s) SERVER=${OPTARG};;
            c) USER_COMMAND=${OPTARG};;
            l) LABELS+=(${OPTARG});;
            b) background="yes";;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists
    check_if_config_file_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$NEW_IMAGE_VERSION}
    else
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}
    fi

    # Check if there is already any container running with the same name...
    if [ "$(docker ps -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
        # If container is running, then bash into it...
        echo "${GREEN}$CONTAINER_NAME is already running.${NC}" >&1
        echo "${GREEN}Attaching to existing container...${NC}" >&1
        ARGS+=(docker exec -u cruise -it $CONTAINER_NAME $ENTRYPOINT)
    elif [ "$(docker ps -a | grep $CONTAINER_NAME)" ]; then
        # If container exist, then start it...
        echo "${GREEN}Starting existing container...${NC}" >&1
        ARGS+=(docker start $CONTAINER_NAME)
    else
        # Check if custom entrypoint given
        if [ "$USER_COMMAND" ]; then
            ENTRYPOINT=$USER_COMMAND
        elif [ "$SERVER" == "octane" ]; then
            ENTRYPOINT="start-server octane"
        elif [ "$SERVER" == "nginx" ]; then
            ENTRYPOINT="start-server"
        fi

        # Check if default ip for container is given
        if [ "$DEFAULT_IP" ]; then
            IP="--ip $DEFAULT_IP"
        fi

        # Check if default port is intentionally empty
        # If it is, skip `-p` parameter completely
        if [ "$DEFAULT_PORT" == "" ]; then
            DEFAULT_PORT=$DEFAULT_PORT
        else
            DEFAULT_PORT="-p $DEFAULT_PORT:80"
        fi

        # Run the image with parameters...
        if [ "$background" == "yes" ]; then
            echo "${GREEN}Starting new container in background...${NC}" >&1
            ARGS+=(docker run -d --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK $IP --add-host host.docker.internal:host-gateway $DEFAULT_PORT ${EXPOSE_PORTS[@]/#/-p } ${LABELS[@]/#/-l } cruise-$IMAGE_VERSION:latest $ENTRYPOINT)
        else
            echo "${GREEN}Starting new temporary container...${NC}" >&1
            ARGS+=(docker run --rm --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK $IP --add-host host.docker.internal:host-gateway $DEFAULT_PORT ${EXPOSE_PORTS[@]/#/-p } ${LABELS[@]/#/-l } cruise-$IMAGE_VERSION:latest $ENTRYPOINT)
        fi
    fi

# Stop the application container...
elif [ "$1" == "stop" ]; then
    shift 1

    while getopts v:f OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            f) full="yes";;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists
    check_if_config_file_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$NEW_IMAGE_VERSION}
    else
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}
    fi

    # Remove the container if -f option provided
    if [ "$full" == "yes" ]; then
        # Check if the container exists at all...
        if [ "$(docker ps -a -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
            echo "${GREEN}Stopping and removing running container...${NC}" >&1
            ARGS+=(docker rm -f $CONTAINER_NAME)
        else
            cruise_is_not_running
        fi
    else
        # Check if there is already any container running with the same name...
        if [ "$(docker ps -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
            echo "${GREEN}Stopping running container...${NC}" >&1
            ARGS+=(docker stop $CONTAINER_NAME)
        else
            cruise_is_not_running
        fi
    fi

# Restart the application container...
elif [ "$1" == "restart" ]; then
    shift 1

    while getopts v: OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists
    check_if_config_file_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$NEW_IMAGE_VERSION}
    else
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}
    fi

    # Check if there is already any container running with the same name...
    if [ "$(docker ps -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
        echo "${GREEN}Restarting running container...${NC}" >&1
        ARGS+=(docker restart $CONTAINER_NAME)
    else
        cruise_is_not_running
    fi

# Show cruise status...
elif [ "$1" == "status" ]; then
    shift 1

    check_if_docker_running
    check_if_network_exists

    echo "Debugging Enabled: ${BOLD}$CRUISE_DEBUG_ENABLED${NC}" >&1
    echo "Stop On Debug: ${BOLD}$STOP_ON_DEBUG${NC}" >&1
    echo "Default Environment: ${BOLD}$DEFAULT_IMAGE_VERSION${NC}" >&1
    echo "Default Network: ${BOLD}$DEFAULT_NETWORK${NC}" >&1
    echo "" >&1
    echo "Available Environments:" >&1
    ls ~/.cruise/environments
    echo "" >&1

    exit 0

# Show cruise application containers...
elif [ "$1" == "containers" ]; then
    shift 1

    while getopts a OPTION; do
        case $OPTION in
            a) show="-a";;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists

    CRUISE_CONTAINERS=$(
        docker ps $show --format '{{.Names}}' 2>/dev/null \
        | grep -E '[^-]+-cruise-[^-]+' \
        | while read -r name; do
            networks=$(docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{printf "%s=%s " $k $v.IPAddress}}{{end}}' "$name")
            status=$(docker inspect -f '{{.State.Status}}' "$name")
            echo "$status|${CYAN}Name:${NC} ${GREEN}$name${NC} | ${CYAN}Network:${NC} ${YELLOW}$networks${NC} | ${CYAN}Status:${NC} $status"
        done \
        | sort -t'|' -k1,1r \
        | cut -d'|' -f2-
    )

    # Check if any cruise containers running...
    if [[ -n "$CRUISE_CONTAINERS" ]]; then
        echo "Found cruise containers..." >&1
        echo "$CRUISE_CONTAINERS" >&1
    else
        echo "${BOLD}No running cruise containers found.${NC}" >&1
    fi

    exit 0

# Check project cruise status...
elif [ "$1" == "check" ]; then
    shift 1

    while getopts v: OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running

    # Take version from -v, else .cruise config, else default...
    VERSION_SOURCE="default"
    if [ -n "$NEW_IMAGE_VERSION" ]; then
        IMAGE_VERSION=$NEW_IMAGE_VERSION
        VERSION_SOURCE="-v option"
    elif [[ -f ".cruise" && -s ".cruise" ]]; then
        source ".cruise"
        VERSION_SOURCE=".cruise config file"
    fi

    CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}

    # Versions other than the default need -v for build/start/traefik to pick them up...
    if [ "$IMAGE_VERSION" == "$DEFAULT_IMAGE_VERSION" ]; then
        VERSION_FLAG=""
    else
        VERSION_FLAG=" -v $IMAGE_VERSION"
    fi

    # Everything below is read-only, nothing is created or started...
    if docker network inspect "$DEFAULT_NETWORK" > /dev/null 2>&1; then
        NETWORK_STATUS="${GREEN}exists${NC}"
    else
        NETWORK_STATUS="${YELLOW}not found${NC}"
    fi

    if docker image inspect "cruise-$IMAGE_VERSION:latest" > /dev/null 2>&1; then
        IMAGE_STATUS="${GREEN}found${NC}"
        IMAGE_FOUND="yes"
    else
        IMAGE_STATUS="${YELLOW}not found${NC}"
        IMAGE_FOUND="no"
    fi

    CONTAINER_STATE=$(docker container inspect -f '{{.State.Status}}' "$CONTAINER_NAME" 2> /dev/null)

    if [ "$CONTAINER_STATE" == "running" ]; then
        CONTAINER_STATUS="${GREEN}running${NC}"
    elif [ -n "$CONTAINER_STATE" ]; then
        CONTAINER_STATUS="${YELLOW}$CONTAINER_STATE${NC}"
    else
        CONTAINER_STATUS="${YELLOW}not found${NC}"
    fi

    TRAEFIK_STATE=$(docker container inspect -f '{{.State.Status}}' "$TRAEFIK_CONTAINER_NAME" 2> /dev/null)

    if [ -n "$TRAEFIK_STATE" ]; then
        TRAEFIK_STATUS="${GREEN}$TRAEFIK_STATE${NC}"
    else
        TRAEFIK_STATUS="${YELLOW}not found${NC}"
    fi

    echo "Checking cruise status for project: ${BOLD}${PWD##*/}${NC}" >&1
    echo "" >&1
    echo "${CYAN}Config:${NC} $VERSION_SOURCE (${BOLD}IMAGE_VERSION=$IMAGE_VERSION${NC})" >&1
    echo "${CYAN}Network:${NC} ${BOLD}$DEFAULT_NETWORK${NC} $NETWORK_STATUS" >&1
    echo "${CYAN}Image:${NC} ${BOLD}cruise-$IMAGE_VERSION:latest${NC} $IMAGE_STATUS" >&1
    echo "${CYAN}Container:${NC} ${BOLD}$CONTAINER_NAME${NC} $CONTAINER_STATUS" >&1

    # Extra details for an existing container...
    if [ -n "$CONTAINER_STATE" ]; then
        CONTAINER_NETWORKS=$(docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{printf "%s=%s " $k $v.IPAddress}}{{end}}' "$CONTAINER_NAME" 2> /dev/null)
        # Docker reports IPv4 and IPv6 bindings separately, keep one entry per published container port...
        CONTAINER_PORTS=$(docker inspect -f '{{range $p, $b := .NetworkSettings.Ports}}{{range $x := $b}}{{printf "%s:%s->%s " $x.HostIp $x.HostPort $p}}{{end}}{{end}}' "$CONTAINER_NAME" 2> /dev/null | awk '{ out = ""; for (i = 1; i <= NF; i++) { match($i, /[^:]+->/); key = substr($i, RSTART); if (!(key in seen)) { seen[key] = 1; out = out (out == "" ? "" : " ") $i } } print out }')
        CONTAINER_CREATED=$(docker inspect -f '{{.Created}}' "$CONTAINER_NAME" 2> /dev/null | cut -c1-19)

        echo "  ${CYAN}Networks:${NC} $CONTAINER_NETWORKS" >&1
        echo "  ${CYAN}Ports:${NC} ${CONTAINER_PORTS:-none}" >&1
        echo "  ${CYAN}Created:${NC} $CONTAINER_CREATED" >&1
    fi

    echo "${CYAN}Traefik proxy:${NC} ${BOLD}$TRAEFIK_CONTAINER_NAME${NC} $TRAEFIK_STATUS" >&1

    # Check if the version has a matching environment to build from...
    if [ ! -d "$CRUISE_DIRECTORY/environments/$IMAGE_VERSION" ]; then
        echo "" >&2
        echo "${YELLOW}Warning: environment $IMAGE_VERSION not found in $CRUISE_DIRECTORY/environments, image build will fail.${NC}" >&2
    fi

    echo "" >&1
    if [ "$CONTAINER_STATE" == "running" ]; then
        echo "${GREEN}Suggested next step:${NC} cruise start$VERSION_FLAG or cruise traefik$VERSION_FLAG (will attach to the running container)" >&1

        exit 0
    elif [ -n "$CONTAINER_STATE" ]; then
        echo "${GREEN}Suggested next step:${NC} cruise start$VERSION_FLAG (will start the existing container)" >&1

        exit 1
    elif [ "$IMAGE_FOUND" == "yes" ]; then
        echo "${GREEN}Suggested next step:${NC} cruise start$VERSION_FLAG or cruise traefik$VERSION_FLAG (will create a new container)" >&1

        exit 2
    else
        echo "${GREEN}Suggested next step:${NC} cruise build$VERSION_FLAG first, then cruise start$VERSION_FLAG or cruise traefik$VERSION_FLAG" >&1

        exit 3
    fi

# Initiate a user zsh shell within the application container...
elif [ "$1" == "shell" ]; then
    shift 1

    while getopts e:n:i:u:v:b OPTION; do
        case $OPTION in
            e) EXPOSE_PORTS+=(${OPTARG});;
            n) DEFAULT_NETWORK=${OPTARG};;
            i) DEFAULT_IP=${OPTARG};;
            u) SHELL_USER=${OPTARG};;
            v) NEW_IMAGE_VERSION=${OPTARG};;
            b) background="yes";;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists
    check_if_config_file_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$NEW_IMAGE_VERSION}
    else
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}
    fi

    # Check if default ip for container is given
    if [ "$DEFAULT_IP" ]; then
        IP="--ip $DEFAULT_IP"
    fi

    # Check if there is already any container running with the same name...
    if [ "$(docker ps -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
        echo "${GREEN}Attaching to existing shell...${NC}" >&1
        ARGS+=(docker exec -u $SHELL_USER -it $CONTAINER_NAME $ENTRYPOINT)
    else
        # Check if there is already container with same name
        if [ "$(docker ps -a | grep $CONTAINER_NAME)" ]; then
            cruise_is_not_running
        fi

        if [ "$background" == "yes" ]; then
            echo "${GREEN}Starting new shell in background...${NC}" >&1
            ARGS+=(docker run -d -it --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK $IP ${EXPOSE_PORTS[@]/#/-p } --add-host host.docker.internal:host-gateway cruise-$IMAGE_VERSION:latest $ENTRYPOINT)
        else
            echo "${GREEN}Starting new temporary container...${NC}" >&1
            ARGS+=(docker run -u $SHELL_USER -it --rm --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK $IP ${EXPOSE_PORTS[@]/#/-p } --add-host host.docker.internal:host-gateway cruise-$IMAGE_VERSION:latest $ENTRYPOINT)
        fi
    fi

# Initiate a root user bash shell within the application container...
elif [ "$1" == "root-shell" ]; then
    shift 1

    while getopts e:n:i:v:b OPTION; do
        case $OPTION in
            e) EXPOSE_PORTS+=(${OPTARG});;
            n) DEFAULT_NETWORK=${OPTARG};;
            i) DEFAULT_IP=${OPTARG};;
            v) NEW_IMAGE_VERSION=${OPTARG};;
            b) background="yes";;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists
    check_if_config_file_exists

    ENTRYPOINT=bash

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$NEW_IMAGE_VERSION}
    else
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}
    fi

    # Check if default ip for container is given
    if [ "$DEFAULT_IP" ]; then
        IP="--ip $DEFAULT_IP"
    fi

    # Check if there is already any container running with the same name...
    if [ "$(docker ps -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
        echo "${GREEN}Attaching to existing shell as root...${NC}" >&1
        ARGS+=(docker exec -it $CONTAINER_NAME $ENTRYPOINT)
    else
        # Check if there is already container with same name
        if [ "$(docker ps -a | grep $CONTAINER_NAME)" ]; then
            cruise_is_not_running
        fi

        if [ "$background" == "yes" ]; then
            echo "${GREEN}Starting new shell in the background as root...${NC}" >&1
            ARGS+=(docker run -d -it --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK $IP ${EXPOSE_PORTS[@]/#/-p } --add-host host.docker.internal:host-gateway cruise-$IMAGE_VERSION:latest $ENTRYPOINT)
        else
            echo "${GREEN}Starting new temporary shell as root...${NC}" >&1
            ARGS+=(docker run -it --rm --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK $IP ${EXPOSE_PORTS[@]/#/-p } --add-host host.docker.internal:host-gateway cruise-$IMAGE_VERSION:latest $ENTRYPOINT)
        fi
    fi

# Run an executable from inside the container...
elif [ "$1" == "run" ]; then
    shift 1

    while getopts v: OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists

    # Check if argument provided
    if [ -z "$1" ]; then
        echo "${RED}Executable name and parameters missing${NC}" >&2

        exit 1
    fi

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        IMAGE_VERSION=$NEW_IMAGE_VERSION
    # Check if .cruise config file exists in the project directory...
    elif [[ -f ".cruise" && -s ".cruise" ]]; then
        echo "${GREEN}Loading environment from .cruise config file...${NC}" >&1

        source ".cruise"
    fi

    ARGS+=(docker run -u $SHELL_USER -it --rm -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK cruise-$IMAGE_VERSION:latest "${@:$OPTIND}")

# Create a Laravel project...
elif [ "$1" == "create" ]; then
    shift 1

    while getopts v: OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists

    # Check if argument provided
    if [ -z "$1" ]; then
        echo "${RED}Project name missing${NC}" >&2

        exit 1
    fi

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$NEW_IMAGE_VERSION}
    else
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}
    fi

    # Check if there is already any container running with the same name...
    if [ "$(docker ps -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
        ARGS+=(docker exec -it $CONTAINER_NAME composer create-project laravel/laravel "${@:$OPTIND}")
    else
        # Check if there is already container with same name
        if [ "$(docker ps -a | grep $CONTAINER_NAME)" ]; then
            cruise_is_not_running
        fi

        ARGS+=(docker run -u $SHELL_USER -it --rm --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK cruise-$IMAGE_VERSION:latest composer create-project laravel/laravel "${@:$OPTIND}")
    fi

# Start the application container with Traefik support...
elif [ "$1" == "traefik" ]; then
    shift 1

    while getopts v:n:i:p:e:s:c:l:b OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            n) DEFAULT_NETWORK=${OPTARG};;
            i) DEFAULT_IP=${OPTARG};;
            p) DEFAULT_PORT=${OPTARG};;
            e) EXPOSE_PORTS+=(${OPTARG});;
            s) SERVER=${OPTARG};;
            c) USER_COMMAND=${OPTARG};;
            l) LABELS+=(${OPTARG});;
            b) background="yes";;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists
    check_if_config_file_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$NEW_IMAGE_VERSION}
    else
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}
    fi

    # Check if there is already any container running with the same name...
    if [ "$(docker ps -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
        # If container is running, then bash into it...
        echo "${GREEN}Attaching to existing container...${NC}" >&1
        ARGS+=(docker exec -u cruise -it $CONTAINER_NAME $ENTRYPOINT)
    elif [ "$(docker ps -a | grep $CONTAINER_NAME)" ]; then
        # If container exist, then start it...
        echo "${GREEN}Starting existing container...${NC}" >&1
        ARGS+=(docker start $CONTAINER_NAME)
    else
        # Check if custom entrypoint given
        if [ "$USER_COMMAND" ]; then
            ENTRYPOINT=$USER_COMMAND
        elif [ "$SERVER" == "octane" ]; then
            ENTRYPOINT="start-server octane"
        elif [ "$SERVER" == "nginx" ]; then
            ENTRYPOINT="start-server"
        fi

        # Check if default ip for container is given
        if [ "$DEFAULT_IP" ]; then
            IP="--ip $DEFAULT_IP"
        fi

        # Check if user provided labels for the image
        # Skip default labels in this case
        if [ ! ${LABELS[@]} ]; then
            TRAEFIK_ARGS="-l traefik.enable=true -l traefik.http.routers.${PWD##*/}.entrypoints=http -l traefik.http.services.${PWD##*/}.loadbalancer.server.port=${DEFAULT_PORT} -l traefik.http.routers.${PWD##*/}.rule=Host(\`${PWD##*/}.localhost\`)"
        fi

        # Run the image with parameters...
        if [ "$background" == "yes" ]; then
            echo "${GREEN}Starting new traefik proxy compatible container in background...${NC}" >&1
            ARGS+=(docker run -d --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK $IP --add-host host.docker.internal:host-gateway $TRAEFIK_ARGS ${EXPOSE_PORTS[@]/#/-p } ${LABELS[@]/#/-l } cruise-$IMAGE_VERSION:latest $ENTRYPOINT)
        else
            echo "${GREEN}Starting new temporary traefik proxy compatible container...${NC}" >&1
            ARGS+=(docker run --rm --name $CONTAINER_NAME -v "${PWD}":$WORKING_DIRECTORY -w $WORKING_DIRECTORY --cap-add=NET_ADMIN --net $DEFAULT_NETWORK $IP --add-host host.docker.internal:host-gateway $TRAEFIK_ARGS ${EXPOSE_PORTS[@]/#/-p } ${LABELS[@]/#/-l } cruise-$IMAGE_VERSION:latest $ENTRYPOINT)
        fi
    fi

# Open the project in vscode inside the container...
elif [ "$1" == "code" ]; then
    shift 1

    while getopts v: OPTION; do
        case $OPTION in
            v) NEW_IMAGE_VERSION=${OPTARG};;
            *) invalid_arguments_provided;;
        esac
    done

    check_if_docker_running
    check_if_network_exists
    check_if_config_file_exists

    if [ -n "$NEW_IMAGE_VERSION" ]; then
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$NEW_IMAGE_VERSION}
    else
        CONTAINER_NAME=${CONTAINER_NAME/$DEFAULT_IMAGE_VERSION/$IMAGE_VERSION}
    fi

    # Make sure vscode attaches as the cruise user instead of root...
    configure_vscode_attach_config ${NEW_IMAGE_VERSION:-$IMAGE_VERSION}

    CONTAINER_HEX=$(echo -n "$CONTAINER_NAME" | od -A n -t x1 | sed 's/ *//g' | tr -d '\n')

    # Check if there is already any container running with the same name...
    if [ "$(docker ps -f name=$CONTAINER_NAME | grep $CONTAINER_NAME)" ]; then
        # If container is running, then bash into it...
        echo "${GREEN}Attaching to existing container...${NC}" >&1
        ARGS+=(code --folder-uri vscode-remote://attached-container+$CONTAINER_HEX/var/www/html)
    elif [ "$(docker ps -a | grep $CONTAINER_NAME)" ]; then
        # If container exist, then start it...
        echo "${GREEN}Starting existing container and attaching to it...${NC}" >&1

        if docker start $CONTAINER_NAME > /dev/null; then
            ARGS+=(code --folder-uri vscode-remote://attached-container+$CONTAINER_HEX/var/www/html)
        else
            echo "${RED}Failed to start container $CONTAINER_NAME${NC}" >&2

            exit 1
        fi
    else
        cruise_is_not_running
    fi

# Pass unknown commands to the "docker" binary...
else
    ARGS+=(docker "$@")
fi

# Print the generated docker command when debug is enabled...
if [ "$CRUISE_DEBUG_ENABLED" == "yes" ]; then
    echo "" >&1
    echo "${YELLOW}Debug command:${NC} ${CYAN}${ARGS[@]}${NC}" >&1
    echo "" >&1

    # Stop execution if STOP_ON_DEBUG is enabled...
    if [ "$STOP_ON_DEBUG" == "yes" ]; then
        exit 1
    fi
fi

# Run Docker with the defined arguments...
"${ARGS[@]}"
