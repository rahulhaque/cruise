#!/usr/bin/env bash

_cruise_autocomplete() {
    local cur prev cmd flags w i commands
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    commands="environments build start stop restart status containers check shell root-shell run export import remove create traefik code install uninstall"

    cmd=""
    for ((i = 1; i < COMP_CWORD; i++)); do
        w="${COMP_WORDS[i]}"
        case " $commands " in
            *" $w "*)
                cmd="$w"
                break
                ;;
        esac
    done

    case "$cmd" in
        start | traefik)
            flags="-v -n -i -p -e -s -c -l -b"
            ;;
        shell)
            flags="-v -n -i -e -u -b"
            ;;
        root-shell)
            flags="-v -n -i -e -b"
            ;;
        build | stop)
            flags="-v -f"
            ;;
        remove)
            flags="-v -a -f"
            ;;
        check | create | export | restart | code | run)
            flags="-v"
            ;;
        containers)
            flags="-a"
            ;;
        uninstall)
            flags="-f"
            ;;
        *)
            flags=""
            ;;
    esac

    case "$cur" in
        -*)
            COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
            return 0
            ;;
    esac

    case "$prev" in
        -v)
            if [[ -d "$HOME/.cruise/environments" ]]; then
                COMPREPLY=( $(compgen -W "$(ls "$HOME/.cruise/environments" 2>/dev/null)" -- "$cur") )
            fi
            return 0
            ;;
        -n)
            case "$cmd" in
                start | traefik | shell | root-shell)
                    COMPREPLY=( $(compgen -W "$(docker network ls --format '{{.Name}}' 2>/dev/null)" -- "$cur") )
                    ;;
            esac
            return 0
            ;;
        -s)
            case "$cmd" in
                start | traefik)
                    COMPREPLY=( $(compgen -W "nginx octane" -- "$cur") )
                    ;;
            esac
            return 0
            ;;
        -u)
            case "$cmd" in
                shell)
                    COMPREPLY=( $(compgen -W "cruise root" -- "$cur") )
                    ;;
            esac
            return 0
            ;;
        -i | -p | -e | -c | -l)
            return 0
            ;;
    esac

    if [[ "$cmd" == "import" ]]; then
        COMPREPLY=( $(compgen -f -- "$cur") )
        return 0
    fi

    if [[ -n "$cmd" ]]; then
        COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
    elif [[ "$prev" != -* ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    fi

    return 0
}

complete -F _cruise_autocomplete cruise
